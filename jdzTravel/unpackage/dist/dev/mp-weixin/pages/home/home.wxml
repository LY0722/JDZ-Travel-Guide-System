<view class="home-container"><swiper class="swiper" indicator-dots autoplay circular interval="3000"><swiper-item wx:for="{{a}}" wx:for-item="item" wx:key="c"><image src="{{item.a}}" mode="aspectFill" class="swiper-image" bindtap="{{item.b}}"></image></swiper-item></swiper><view class="search-bar"><input class="search-input" placeholder="搜索景点、店铺或美食" bindtap="{{b}}" value="{{c}}" bindinput="{{d}}" confirm-type="search" bindconfirm="{{e}}"/><uni-icons wx:if="{{g}}" bindclick="{{f}}" u-i="77b2d0dc-0" bind:__l="__l" u-p="{{g}}"></uni-icons></view><view class="function-grid"><view class="function-item" bindtap="{{i}}"><view class="function-icon" style="background-color:#FF6B6B"><uni-icons wx:if="{{h}}" u-i="77b2d0dc-1" bind:__l="__l" u-p="{{h}}"></uni-icons></view><text class="function-text">智能问答</text></view><view class="function-item" bindtap="{{k}}"><view class="function-icon" style="background-color:#4ECDC4"><uni-icons wx:if="{{j}}" u-i="77b2d0dc-2" bind:__l="__l" u-p="{{j}}"></uni-icons></view><text class="function-text">地图导航</text></view><view class="function-item" bindtap="{{m}}"><view class="function-icon" style="background-color:#45B7D1"><uni-icons wx:if="{{l}}" u-i="77b2d0dc-3" bind:__l="__l" u-p="{{l}}"></uni-icons></view><text class="function-text">社区互动</text></view><view class="function-item" bindtap="{{o}}"><view class="function-icon" style="background-color:#FFA5A5"><uni-icons wx:if="{{n}}" u-i="77b2d0dc-4" bind:__l="__l" u-p="{{n}}"></uni-icons></view><text class="function-text">景德镇美食</text></view></view><view class="section"><view class="section-header"><text class="section-title">热门景点</text><text class="section-more" bindtap="{{p}}">查看更多 ></text></view><scroll-view class="scroll-view" scroll-x><view wx:for="{{q}}" wx:for-item="spot" wx:key="f" class="spot-item" bindtap="{{spot.g}}"><image src="{{spot.a}}" mode="aspectFill" class="spot-image"></image><view class="spot-info"><text class="spot-name">{{spot.b}}</text><view class="spot-rating"><uni-icons wx:if="{{r}}" u-i="{{spot.c}}" bind:__l="__l" u-p="{{r}}"></uni-icons><text>{{spot.d}}</text></view><text class="spot-address">{{spot.e}}</text></view></view></scroll-view></view><view class="section"><view class="section-header"><text class="section-title">非遗体验店</text><text class="section-more" bindtap="{{s}}">查看更多 ></text></view><view class="shop-list"><view wx:for="{{t}}" wx:for-item="shop" wx:key="g" class="shop-item" bindtap="{{shop.h}}"><image src="{{shop.a}}" mode="aspectFill" class="shop-image"></image><view class="shop-detail"><text class="shop-name">{{shop.b}}</text><text class="shop-type">{{shop.c}}</text><text class="shop-price">{{shop.d}}</text><view class="shop-rating"><uni-icons wx:if="{{v}}" u-i="{{shop.e}}" bind:__l="__l" u-p="{{v}}"></uni-icons><text>{{shop.f}}</text></view></view></view></view></view><view class="section"><view class="section-header"><text class="section-title">景德镇美食</text><text class="section-more" bindtap="{{w}}">查看更多 ></text></view><view wx:if="{{x}}" class="food-card" bindtap="{{B}}"><image src="{{y}}" mode="aspectFill" class="food-image"></image><view class="food-content"><text class="food-title">{{z}}</text><text class="food-desc">{{A}}</text></view></view></view></view>