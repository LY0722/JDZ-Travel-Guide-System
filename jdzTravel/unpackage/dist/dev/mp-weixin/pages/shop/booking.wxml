<view class="booking-container"><view class="shop-info"><image src="{{a}}" mode="aspectFill" class="shop-image"></image><view class="shop-detail"><text class="shop-name">{{b}}</text><text class="shop-type">{{c}}</text><view class="shop-rating"><text class="iconfont icon-star"></text><text>{{d}}</text></view></view></view><view class="booking-form"><view class="form-item"><text class="form-label">体验项目</text><picker bindchange="{{g}}" value="{{h}}" range="{{i}}" range-key="name"><view class="picker">{{e}} ({{f}}) </view></picker></view><view class="form-item"><text class="form-label">预约日期</text><picker mode="date" value="{{k}}" start="{{l}}" end="{{m}}" bindchange="{{n}}"><view class="picker">{{j}}</view></picker></view><view class="form-item"><text class="form-label">预约时间</text><picker mode="time" value="{{p}}" start="09:00" end="18:00" bindchange="{{q}}"><view class="picker">{{o}}</view></picker></view><view class="form-item"><text class="form-label">预约人数</text><view class="stepper"><text class="stepper-btn" bindtap="{{r}}">-</text><text class="stepper-number">{{s}}</text><text class="stepper-btn" bindtap="{{t}}">+</text></view></view><view class="form-item"><text class="form-label">联系人</text><input class="form-input" placeholder="请输入联系人姓名" value="{{v}}" bindinput="{{w}}"/></view><view class="form-item"><text class="form-label">联系电话</text><input class="form-input" placeholder="请输入联系电话" type="number" value="{{x}}" bindinput="{{y}}"/></view><view class="form-item"><text class="form-label">备注信息</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="如有特殊需求请备注" value="{{z}}" bindinput="{{A}}"></textarea></block></view></view><view class="action-bar"><view class="price-info"><text class="price-label">合计：</text><text class="price-amount">¥{{B}}</text></view><view class="submit-btn" bindtap="{{C}}"><text>提交预约</text></view></view></view>