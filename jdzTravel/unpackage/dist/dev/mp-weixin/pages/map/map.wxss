.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
  position: relative;
}
.header {
  flex: none;
  padding: 20rpx 30rpx;
  background-color: #00B4D8;
  color: white;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}
.header .title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}
.header .subtitle {
  font-size: 24rpx;
  display: block;
  margin-top: 10rpx;
  opacity: 0.9;
}
.map-container {
  flex: 1;
  min-height: 0;
  position: relative;
}
.map-container .map {
  width: 100%;
  height: 100%;
}
.map-container .direction-hint {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(255, 255, 255, 0.95);
  padding: 12rpx 25rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  display: flex;
  align-items: center;
  border: 1rpx solid #f0f0f0;
  min-width: 300rpx;
  justify-content: center;
}
.map-container .direction-hint .direction-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-left: 10rpx;
}
.spots-list {
  flex: none;
  height: 280rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
  padding: 10rpx 0;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.spots-list .scroll-view {
  height: 100%;
  white-space: nowrap;
  width: 100%;
}
.spots-list .spot-item {
  display: inline-block;
  width: 280rpx;
  height: 240rpx;
  margin: 0 15rpx;
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  vertical-align: top;
  transition: transform 0.2s;
}
.spots-list .spot-item:active {
  transform: scale(0.98);
}
.spots-list .spot-item:first-child {
  margin-left: 20rpx;
}
.spots-list .spot-item:last-child {
  margin-right: 20rpx;
}
.spots-list .spot-item .spot-image {
  width: 100%;
  height: 150rpx;
  display: block;
}
.spots-list .spot-item .spot-info {
  padding: 15rpx;
  display: flex;
  flex-direction: column;
}
.spots-list .spot-item .spot-info .spot-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.spots-list .spot-item .spot-info .spot-address {
  font-size: 22rpx;
  color: #777;
  margin-top: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.spots-list .spot-item .spot-info .spot-distance {
  font-size: 22rpx;
  color: #00B4D8;
  margin-top: 8rpx;
  font-weight: 500;
}
.route-panel {
  position: absolute;
  bottom: 100rpx;
  left: 30rpx;
  right: 30rpx;
  background-color: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  transform: translateY(0);
  transition: transform 0.3s ease;
  border: 1rpx solid #f0f0f0;
}
.route-panel .panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.route-panel .panel-header .panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.route-panel .route-info {
  margin-bottom: 25rpx;
}
.route-panel .route-info .route-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.route-panel .route-info .route-distance,
.route-panel .route-info .route-time,
.route-panel .route-info .route-direction {
  display: block;
  font-size: 26rpx;
  color: #777;
  margin-top: 8rpx;
}
.route-panel .route-info .route-direction {
  color: #00B4D8;
  font-weight: 500;
}
.route-panel .nav-btn {
  background-color: #00B4D8;
  color: white;
  border-radius: 50rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.route-panel .nav-btn::after {
  border: none;
}
.route-panel .nav-btn:active {
  background-color: #008aa5;
}
.route-panel .nav-btn uni-icons {
  margin-right: 10rpx;
}
.route-panel .walk-btn {
  background-color: #f8f8f8;
  color: #00B4D8;
  border-radius: 50rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
  border: 1rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.route-panel .walk-btn::after {
  border: none;
}
.route-panel .walk-btn:active {
  background-color: #f0f0f0;
}
.route-panel .walk-btn uni-icons {
  margin-right: 10rpx;
}
.location-btn {
  position: absolute;
  right: 30rpx;
  bottom: 320rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
  transition: transform 0.2s;
  border: 1rpx solid #f0f0f0;
}
.location-btn:active {
  transform: scale(0.95);
}