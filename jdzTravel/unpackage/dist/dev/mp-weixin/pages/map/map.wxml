<view class="container"><view class="header"><text class="title">瓷都匠艺之旅</text><text class="subtitle">探索景德镇陶瓷文化</text></view><view class="map-container"><map id="cultureMap" latitude="{{a}}" longitude="{{b}}" markers="{{c}}" polyline="{{d}}" scale="{{e}}" show-location="{{true}}" bindmarkertap="{{f}}" class="map"></map><view wx:if="{{g}}" class="direction-hint"><uni-icons wx:if="{{h}}" u-i="954b9994-0" bind:__l="__l" u-p="{{h}}"></uni-icons><text class="direction-text"> 往{{i}}方向 {{j}}公里 </text></view></view><view class="spots-list"><scroll-view scroll-x class="scroll-view" scroll-with-animation="{{true}}" show-scrollbar="{{false}}"><view wx:for="{{k}}" wx:for-item="spot" wx:key="e" class="spot-item" bindtap="{{spot.f}}"><image src="{{spot.a}}" class="spot-image" mode="aspectFill"></image><view class="spot-info"><text class="spot-name">{{spot.b}}</text><text class="spot-address">{{spot.c}}</text><text wx:if="{{l}}" class="spot-distance"> 距离: {{spot.d}} km </text></view></view></scroll-view></view><view wx:if="{{m}}" class="route-panel"><view class="panel-header"><text class="panel-title">路线规划</text><uni-icons wx:if="{{o}}" bindclick="{{n}}" u-i="954b9994-1" bind:__l="__l" u-p="{{o}}"></uni-icons></view><view class="route-info"><text class="route-text">从您的位置到 {{p}}</text><text class="route-distance">距离: {{q}} km</text><text class="route-time">预计时间: {{r}} 分钟</text><text class="route-direction">方向: 往{{s}}方向</text></view><button class="nav-btn" bindtap="{{v}}"><uni-icons wx:if="{{t}}" u-i="954b9994-2" bind:__l="__l" u-p="{{t}}"></uni-icons> 开始导航 </button><button class="walk-btn" bindtap="{{x}}"><uni-icons wx:if="{{w}}" u-i="954b9994-3" bind:__l="__l" u-p="{{w}}"></uni-icons> 步行导航 </button></view><view class="location-btn" bindtap="{{z}}"><uni-icons wx:if="{{y}}" u-i="954b9994-4" bind:__l="__l" u-p="{{y}}"></uni-icons></view><uni-load-more wx:if="{{A}}" u-i="954b9994-5" bind:__l="__l" u-p="{{B}}"></uni-load-more></view>