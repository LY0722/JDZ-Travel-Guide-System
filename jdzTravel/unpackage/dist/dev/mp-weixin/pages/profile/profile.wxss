
.profile-container.data-v-dd383ca2 {
  min-height: 100vh;
  padding-bottom: 50px;
}

/* 头部样式 */
.profile-header.data-v-dd383ca2 {
  padding: 30rpx;
  padding-top: 80rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 180, 216, 0.2);
}
.user-info.data-v-dd383ca2 {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.avatar.data-v-dd383ca2 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.user-detail.data-v-dd383ca2 {
  margin-left: 30rpx;
  flex: 1;
}
.username.data-v-dd383ca2 {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}
.user-id.data-v-dd383ca2, .user-phone.data-v-dd383ca2 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 8rpx;
}
.stats.data-v-dd383ca2 {
  display: flex;
  margin-top: 20rpx;
}
.stat-item.data-v-dd383ca2 {
  margin-right: 40rpx;
  text-align: center;
}
.stat-number.data-v-dd383ca2 {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}
.stat-label.data-v-dd383ca2 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 菜单区域样式 */
.menu-section.data-v-dd383ca2 {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 30rpx;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.section-title.data-v-dd383ca2 {
  padding: 0 30rpx 20rpx;
  border-bottom: 1rpx solid #f1f1f1;
}
.title-text.data-v-dd383ca2 {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.menu-grid.data-v-dd383ca2 {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
}
.menu-item.data-v-dd383ca2 {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.menu-text.data-v-dd383ca2 {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}
.menu-list.data-v-dd383ca2 {
  padding: 0 30rpx;
}
.menu-list .menu-item.data-v-dd383ca2 {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 0;
  width: 100%;
  border-bottom: 1rpx solid #f1f1f1;
}
.menu-list .menu-item.data-v-dd383ca2:last-child {
  border-bottom: none;
}
.menu-list .menu-text.data-v-dd383ca2 {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  margin: 0 20rpx;
}

/* 登录/退出按钮样式 */
.logout-section.data-v-dd383ca2 {
  margin: 50rpx 30rpx 0;
}
.logout-btn.data-v-dd383ca2, .login-btn.data-v-dd383ca2 {
  background-color: #13d8d2;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border: none;
}
.logout-btn.data-v-dd383ca2 {
  background-color: #fff;
  color: #00B4D8;
  border: 1rpx solid #00B4D8;
}
button.data-v-dd383ca2::after {
  border: none;
}

/* 点击效果 */
.stat-item.data-v-dd383ca2, .menu-item.data-v-dd383ca2 {
  transition: transform 0.2s;
}
.stat-item.data-v-dd383ca2:active, .menu-item.data-v-dd383ca2:active {
  transform: scale(0.95);
}
