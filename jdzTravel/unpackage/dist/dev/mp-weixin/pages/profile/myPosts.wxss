
.my-list-container {
  padding: 32rpx 20rpx 20rpx 20rpx;
  min-height: 100vh;
  background: #f7f8fa;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}
.empty {
  color: #bbb;
  text-align: center;
  margin: 60rpx 0;
  font-size: 28rpx;
}
.post-list {
}
.post-item {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 22rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  transition: box-shadow 0.2s;
}
.post-item:active {
  box-shadow: 0 8rpx 24rpx rgba(0,180,216,0.10);
}
.post-title {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
  margin-bottom: 10rpx;
  display: block;
}
.post-time {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 2rpx;
  display: block;
}
