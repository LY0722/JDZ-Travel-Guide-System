
.comment-container.data-v-ee3fe2f5 {
  background: #fff;
  padding: 20rpx;
  padding-bottom: 100rpx; /* 留出输入框高度 */
}
.comment-input-bar.data-v-ee3fe2f5, .reply-input-bar.data-v-ee3fe2f5 {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.reply-input-bar.data-v-ee3fe2f5 {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  background: #fff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-top: 1rpx solid #eee;
}
.comment-input.data-v-ee3fe2f5 {
  flex: 1;
  border: 1rpx solid #eee;
  border-radius: 30rpx;
  padding: 0 20rpx;
  height: 60rpx;
  font-size: 28rpx;
  margin-right: 10rpx;
}
.send-btn.data-v-ee3fe2f5 {
  background: #00B4D8;
  color: #fff;
  border-radius: 30rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
}
.cancel-btn.data-v-ee3fe2f5 {
  margin-left: 10rpx;
  background: #eee;
  color: #333;
  border-radius: 30rpx;
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
}
.comment-list.data-v-ee3fe2f5 {
  margin-top: 10rpx;
}
.comment-item.data-v-ee3fe2f5, .sub-comment-item.data-v-ee3fe2f5 {
  display: flex;
  margin-bottom: 20rpx;
}
.avatar.data-v-ee3fe2f5 {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}
.comment-main.data-v-ee3fe2f5, .sub-comment-main.data-v-ee3fe2f5 {
  flex: 1;
}
.comment-header.data-v-ee3fe2f5 {
  display: flex;
  align-items: center;
  margin-bottom: 5rpx;
}
.username.data-v-ee3fe2f5 {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-right: 10rpx;
}
.time.data-v-ee3fe2f5 {
  font-size: 22rpx;
  color: #999;
}
.comment-text.data-v-ee3fe2f5 {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 5rpx;
  word-break: break-all;
}
.reply-btn.data-v-ee3fe2f5 {
  color: #00B4D8;
  font-size: 24rpx;
  margin-top: 5rpx;
  cursor: pointer;
}
.sub-comments.data-v-ee3fe2f5 {
  margin-left: 60rpx;
  border-left: 2rpx solid #eee;
  padding-left: 15rpx;
}
