<view class="confirm-container"><view class="order-info"><view class="info-item"><text class="info-label">景点名称</text><text class="info-value">{{a}}</text></view><view class="info-item"><text class="info-label">门票类型</text><text class="info-value">{{b}}</text></view><view class="info-item"><text class="info-label">游玩日期</text><text class="info-value">{{c}}</text></view><view class="info-item"><text class="info-label">购买数量</text><text class="info-value">{{d}}张</text></view><view class="info-item"><text class="info-label">单价</text><text class="info-value">¥{{e}}</text></view></view><view class="section"><view class="section-title">游客信息</view><view class="form-item"><text class="form-label">姓名</text><input class="form-input" placeholder="请输入姓名" value="{{f}}" bindinput="{{g}}"/></view><view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="请输入手机号" type="number" value="{{h}}" bindinput="{{i}}"/></view><view wx:if="{{j}}" class="form-item"><text class="form-label">学生证号</text><input class="form-input" placeholder="请输入学生证号" value="{{k}}" bindinput="{{l}}"/></view><view wx:if="{{m}}" class="form-item"><text class="form-label">身份证号</text><input class="form-input" placeholder="请输入身份证号" value="{{n}}" bindinput="{{o}}"/></view></view><view class="section"><view class="section-title">支付方式</view><view class="payment-method"><view bindtap="{{q}}" class="{{['method-item', r && 'selected']}}"><image src="{{p}}" class="method-icon"></image><text class="method-name">微信支付</text><text class="iconfont icon-check"></text></view><view bindtap="{{t}}" class="{{['method-item', v && 'selected']}}"><image src="{{s}}" class="method-icon"></image><text class="method-name">支付宝支付</text><text class="iconfont icon-check"></text></view></view></view><view class="price-section"><view class="price-item"><text class="price-label">门票总价</text><text class="price-value">¥{{w}}</text></view><view class="price-item"><text class="price-label">优惠</text><text class="price-value">-¥0</text></view><view class="price-item total"><text class="price-label">实付金额</text><text class="price-value">¥{{x}}</text></view></view><view class="action-bar"><view class="price-info"><text class="total-label">合计:</text><text class="total-price">¥{{y}}</text></view><view class="confirm-btn" bindtap="{{z}}"><text class="btn-text">提交订单</text></view></view></view>